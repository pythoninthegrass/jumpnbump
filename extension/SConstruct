#!/usr/bin/env python

# Thin GDExtension shim build (TASK-012.04): SConscript into
# third_party/godot-cpp's own SConstruct exactly the way godot-cpp's own
# test/SConstruct does, pinned to this game's Godot version (4.7).
#
# SConscript()-included scripts run with Python's cwd changed to their own
# directory, so a bare "custom.py" there would resolve inside
# third_party/godot-cpp/, not here -- pass this dir's custom.py by absolute
# path via godot-cpp's own `customs` export hook (SConstruct: `customs +=
# Import("customs")`) instead. Mirrors ~/git/neo_snake/extension/SConstruct.
customs = [File("custom.py").srcnode().abspath]
env = SConscript("../third_party/godot-cpp/SConstruct", {"api_version": "4.7", "customs": customs})

env.Append(CPPPATH=["src/", "../include"])
sources = Glob("src/*.cpp")

# Link core/zig-out/lib/libjumpnbump.a (core/abi.zig, TASK-012.02) as an
# env.File(...) rather than -ljumpnbump -Lpath: a bare linker flag doesn't
# tell SCons the .a is a real input, so a rebuilt core lib would silently
# not trigger a relink here (docs/build-layout.md).
core_lib = env.File("../core/zig-out/lib/libjumpnbump.a")
env.Append(LIBS=[core_lib])

# Output name and directory match godot-cpp's own test/SConstruct convention
# (env["suffix"] already encodes platform/target/arch/.nothreads); game/bin/
# is where game/bin/jumpnbump.gdextension (TASK-012.05) points its
# per-platform [libraries] entries.
#
# macOS (TASK-012.05) is the one platform where the .gdextension's
# [libraries] entry (macos.debug/macos.release, see
# game/bin/jumpnbump.gdextension) names a *.framework directory with no arch
# suffix, not a flat .so/.dylib -- godot-cpp's own env["suffix"] always
# appends arch (tools/godotcpp.py), and neither godot-cpp nor Godot's own
# docs (gdextension_cpp_example.rst) do any framework-bundle packaging for
# the extension's own primary library, so this repo's SConstruct builds the
# bundle directly: a directory literally named
# "libjumpnbump.macos.<target>.framework" containing one flat Mach-O binary
# of the same name (minus the .framework suffix) -- the same shape
# godot-cpp's own test/SConstruct uses and ~/git/neo_snake/extension/
# SConstruct already established; no Contents/Info.plist nesting required
# for a GDExtension's own primary library (that nesting is only for a
# *dependency* framework per gdextension_file.rst's Contents/Frameworks
# convention).
if env["platform"] == "macos":
    # Apple's newer default linker (ld-prime, Xcode 26+) enforces 8-byte
    # alignment on every Mach-O archive member; Zig's own archiver (which
    # produces core/zig-out/lib/libjumpnbump.a via `zig build abi`) doesn't
    # satisfy that for at least one member, failing this final link step
    # with "not 8-byte aligned in ... libjumpnbump.a". The older
    # `ld_classic` linker (still shipped, `-Wl,-ld_classic`, deprecated but
    # functional) doesn't enforce this and links the same archive cleanly --
    # confirmed against the identical failure mode on the real archive by
    # ~/git/neo_snake's own TASK-043.
    env.Append(LINKFLAGS=["-Wl,-ld_classic"])
    bundle_name = "libjumpnbump.macos.{}.framework".format(env["target"])
    library = env.SharedLibrary(
        "../game/bin/{}/{}".format(bundle_name, bundle_name.removesuffix(".framework")),
        source=sources,
    )
else:
    library = env.SharedLibrary(
        "../game/bin/libjumpnbump{}{}".format(env["suffix"], env["SHLIBSUFFIX"]),
        source=sources,
    )
env.Depends(library, core_lib)

Default(library)
